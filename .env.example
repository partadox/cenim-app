# Template konfigurasi rahasia CENIM.
# Copy file ini menjadi .env lalu isi nilainya:  cp .env.example .env && chmod 600 .env
# .env TIDAK BOLEH di-commit (sudah masuk .gitignore).
#
# Format: KEY=value. Nilai yang mengandung spasi, '#', atau '$' tulis dalam
# kutip tunggal. true/false ditulis tanpa kutip.

# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_ENV=production                 # local | production
APP_URL=https://elib.its.ac.id     # hanya skema + host, tanpa trailing slash
APP_BASE=/conf/cenim               # path web root situs (folder yang berisi index.php & cenim-app/)
APP_TZ=Asia/Jakarta

# ── Penyimpanan lokal: database, log, backup, cache ───────────────────────
# Rekomendasi: di luar public_html, mis. /home/<akun-cpanel>/cenim-storage
# (cek path home di cPanel > General Information > Home Directory)
STORAGE_PATH=/home/<akun-cpanel>/cenim-storage
DB_PATH=/home/<akun-cpanel>/cenim-storage/db/cenim.sqlite
STORAGE_DRIVER=s3                  # s3 (object storage Tandikat) | local

# ── Object storage Tandikat (RustFS, S3-compatible) ─────────────────────────
# Menyimpan aset tema (public/theme/), gambar publik (public/media/), dan
# unggahan author (private/uploads/). Bucket privat; cek: php bin/storage.php check
TANDIKAT_ENDPOINT=https://s3.ceits.id
TANDIKAT_REGION=us-east-1
TANDIKAT_BUCKET=cenim
TANDIKAT_USER=
TANDIKAT_PASSWORD=''
# Kosongkan selama bucket privat (aset lewat cenim-app/public/asset.php). Isi,
# mis. https://s3.ceits.id/cenim, hanya bila "public/" dibuka baca-anonim + CORS.
TANDIKAT_PUBLIC_URL=

# ── Autentikasi admin (tanpa tabel user, hanya key) ─────────────────────────
# Hasil password_hash(), bukan key mentah. Buat dengan:
#   php -r "echo password_hash('KEY-ADMIN-ANDA', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_KEY_HASH=''

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (Zoho ZeptoMail) ──────────────────────────────────────────────────
# Login author & panitia memakai kode OTP lewat email: di produksi WAJIB true.
# false = email tidak dikirim, hanya disimpan di <STORAGE_PATH>/logs/mail/ (untuk lokal).
MAIL_ENABLED=true
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_SECURE=tls                    # tls | ssl | (kosong)
SMTP_USER=emailapikey
SMTP_PASS=''                       # token ZeptoMail (Mail Agent → SMTP)
SMTP_SENDER=noreply@ceits.id
SMTP_SENDER_NAME=CENIM             # cadangan; nama pengirim, Reply-To & penutup email diatur di admin → Settings → Email


# ── Header keamanan (opsional) ──────────────────────────────────────
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# HSTS berlaku untuk SELURUH host (elib.its.ac.id), bukan hanya /conf/cenim —
# nyalakan hanya dengan persetujuan pengelola server.
# HSTS_ENABLED=false

# ── Ekstensi PHP opsional (opsional) ────────────────────────────────
# curl, gd, zip, dan intl TIDAK wajib: tanpa itu aplikasi memakai pengganti
# PHP murni (socket TLS, render PNG di browser, ZipWriter, daftar negara).
# HTTP_TRANSPORT=socket                 # paksa socket walau curl ada (uji)
# SIMULATE_MISSING_EXT=curl,gd,zip,intl # uji lokal seolah ekstensi tidak ada
